// SBC Tool · B-39 astro-quant swing windows
// Draws ENTRY lines (heliocentric Earth-planet aspect windows) and EXIT lines
// (Gann + Fibonacci + indicator confluence) on a daily NIFTY chart, and shades
// each ENTRY -> next EXIT span.
//
// Pine Script can't call an HTTP API, so paste the dates in the inputs:
//   ENTRY: GET /api/engine/aspect_windows?start=...&end=...&aspect=SS&format=tv
//   EXIT:  the "exits" object from GET /api/engine/swing_windows?start=...&end=...
// Either a plain list (2026-02-25, 2026-12-23) or the raw JSON payload works;
// anything that isn't a YYYY-MM-DD date is ignored.
//
// Research output, not trading advice: in testing (docs/research/swing_validation_*.md)
// these entries did no better than random dates.

//@version=5
indicator("SBC astro swing windows", overlay = true, max_lines_count = 500, max_labels_count = 500)

entryText  = input.text_area("", "ENTRY dates (YYYY-MM-DD or the API payload)")
exitText   = input.text_area("", "EXIT dates (YYYY-MM-DD or the API payload)")
entryLabel = input.string("ENTRY", "ENTRY label")
entryColor = input.color(color.new(color.teal, 0), "ENTRY colour")
exitColor  = input.color(color.new(color.orange, 0), "EXIT colour")
shade      = input.bool(true, "Shade ENTRY -> EXIT windows")
showLabels = input.bool(true, "Show labels")

// Parse every YYYY-MM-DD token into a timestamp at the NSE open (09:15 IST).
parseDates(string src) =>
    out = array.new_int()
    clean = str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(src, "\"", ","), "[", ","), "]", ","), "{", ","), "}", ","), " ", ",")
    clean := str.replace_all(clean, "\n", ",")
    for tok in str.split(clean, ",")
        n = str.length(tok)
        if n >= 10
            d = str.substring(tok, n - 10, n)
            if str.substring(d, 4, 5) == "-" and str.substring(d, 7, 8) == "-"
                y = str.tonumber(str.substring(d, 0, 4))
                m = str.tonumber(str.substring(d, 5, 7))
                dd = str.tonumber(str.substring(d, 8, 10))
                if not na(y) and not na(m) and not na(dd)
                    array.push(out, timestamp("Asia/Kolkata", int(y), int(m), int(dd), 9, 15))
    array.sort(out, order.ascending)
    out

var int[] entries = parseDates(entryText)
var int[] exits = parseDates(exitText)

// First EXIT at or after each ENTRY (0 when none yet).
var int[] pairedExit = array.new_int()
if barstate.isfirst
    for e in entries
        x = 0
        for t in exits
            if t >= e and x == 0
                x := t
        array.push(pairedExit, x)

inWindow = false
if shade and array.size(entries) > 0
    for i = 0 to array.size(entries) - 1
        e = array.get(entries, i)
        x = array.get(pairedExit, i)
        if time >= e and (x == 0 ? time <= e + 5 * 86400000 : time <= x)
            inWindow := true
bgcolor(inWindow ? color.new(entryColor, 88) : na)

if barstate.islast
    for e in entries
        line.new(e, low, e, high, xloc = xloc.bar_time, extend = extend.both, color = entryColor, width = 2)
        if showLabels
            label.new(e, high, entryLabel, xloc = xloc.bar_time, yloc = yloc.abovebar, color = entryColor, textcolor = color.white, style = label.style_label_down, size = size.small)
    for x in exits
        line.new(x, low, x, high, xloc = xloc.bar_time, extend = extend.both, color = exitColor, width = 2, style = line.style_dashed)
        if showLabels
            label.new(x, low, "EXIT", xloc = xloc.bar_time, yloc = yloc.belowbar, color = exitColor, textcolor = color.white, style = label.style_label_up, size = size.small)
